# Copy to .env (gitignored) and fill in real values, then push with
#   bash scripts/push-secrets.sh
# .env is the source of truth — keep a backup in a password manager.
# Cloudflare's encrypted variables cannot be read back.
# Pages secrets bind on the NEXT deployment — redeploy after pushing.

# Must equal MTW_ISSUE_API_KEY in the parchment worker
# (generate: openssl rand -hex 32; roll both sides together).
PARCHMENT_API_KEY=

# Turnstile widget secret (Cloudflare dashboard > Turnstile)
TURNSTILE_SECRET_KEY=
